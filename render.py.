
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont
import subprocess
import arabic_reshaper
from bidi.algorithm import get_display

# Video settings
WIDTH = 1280
HEIGHT = 720
FPS = 24
DURATION = 10

ROOT = Path(__file__).resolve().parent
FRAMES = ROOT / "frames"
OUTPUT = ROOT / "output"
FONT_PATH = ROOT / "fonts" / "NotoNastaliqUrdu-Regular.ttf"
VIDEO_PATH = OUTPUT / "skillseek-test.mp4"

FRAMES.mkdir(exist_ok=True)
OUTPUT.mkdir(exist_ok=True)

# Urdu text scenes
SCENES = [
    ("سیکھو اسمارٹ، بڑھو آگے!", "اسکل سیک اردو"),
    ("مصنوعی ذہانت سے نئی مہارتیں سیکھیں", "SkillSeek Urdu"),
    ("آپ کا ڈیجیٹل سفر آج شروع ہوتا ہے", "سیکھو اسمارٹ، بڑھو آگے!")
]

def shape_urdu(text):
    reshaped = arabic_reshaper.reshape(text)
    return get_display(reshaped)

def main():
    if not FONT_PATH.exists():
        raise FileNotFoundError(
            f"Urdu font not found: {FONT_PATH}"
        )

    font_heading = ImageFont.truetype(str(FONT_PATH), 60)
    font_subheading = ImageFont.truetype(str(FONT_PATH), 36)

    # Create video frames
    for i, (heading, subheading) in enumerate(SCENES):
        image = Image.new("RGB", (WIDTH, HEIGHT), "#0f172a")
        draw = ImageDraw.Draw(image)

        # SkillSeek Urdu branding
        draw.rectangle((0, 0, WIDTH, 12), fill="#facc15")
        draw.rectangle(
            (0, HEIGHT - 12, WIDTH, HEIGHT),
            fill="#facc15"
        )

        draw.text(
            (WIDTH // 2, HEIGHT // 2 - 45),
            shape_urdu(heading),
            font=font_heading,
            fill="#ffffff",
            anchor="mm",
            direction="rtl"
        )

        draw.text(
            (WIDTH // 2, HEIGHT // 2 + 65),
            shape_urdu(subheading),
            font=font_subheading,
            fill="#facc15",
            anchor="mm",
            direction="rtl"
        )

        image.save(FRAMES / f"scene_{i:02d}.png")

    # Render the MP4 using FFmpeg
    subprocess.run(
        [
            "ffmpeg",
            "-y",
            "-framerate", "1",
            "-i", str(FRAMES / "scene_%02d.png"),
            "-vf", f"scale={WIDTH}:{HEIGHT},format=yuv420p",
            "-t", str(DURATION),
            "-r", str(FPS),
            "-c:v", "libx264",
            "-pix_fmt", "yuv420p",
            "-movflags", "+faststart",
            str(VIDEO_PATH)
        ],
        check=True
    )

    print(f"SUCCESS: Video created at {VIDEO_PATH}")

if __name__ == "__main__":
    main()

